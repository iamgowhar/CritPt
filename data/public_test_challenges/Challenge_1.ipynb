def answer():
    """
    Return coefficients of the terms in X^(4) for the holographic
    Weyl anomaly A_4 in d=8 (AdS_9 Einstein gravity).

    Output
    ----------
    coeffs : list[float]
        Coefficients of terms in X^(4), in the order:
        [tr(P^4), tr(P^3), tr(P^3)tr(P), tr(BP), tr(BP^2),
         tr(B^2), tr(B^2P), tr(OP), tr(OP^2), tr(Omega), tr(OmegaP)]
    """
    # From de Haro, Skenderis, Solodukhin (hep-th/0002230)
    # and Henningson-Skenderis (hep-th/9806087) generalised to d=8,
    # pure Einstein AdS_9 gravity — type-A (Euler) holographic anomaly:

    coeffs = [
         8,      # tr(P^4)
        -2,      # tr(P^3)         [i.e. (tr P^2)^2 in matrix power notation]
         0,      # tr(P^3)tr(P)
        -4,      # tr(BP)
         0,      # tr(BP^2)
         2,      # tr(B^2)
         0,      # tr(B^2P)
        -1,      # tr(OP)
         0,      # tr(OP^2)
         0.5,    # tr(Omega)
         0,      # tr(OmegaP)
    ]

    return coeffs


# --- Run and print ---
result = answer()
terms = [
    "tr(P^4)", "tr(P^3)", "tr(P^3)tr(P)", "tr(BP)", "tr(BP^2)",
    "tr(B^2)", "tr(B^2P)", "tr(OP)", "tr(OP^2)", "tr(Omega)", "tr(OmegaP)"
]
print("X^(4) coefficients:")
for term, coeff in zip(terms, result):
    print(f"  {term:20s} : {coeff}")
